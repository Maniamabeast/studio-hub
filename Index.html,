<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Studio Hub | Books & Anime</title>
  <!-- Tailwind CSS for sleek styling -->
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body {
      background-color: #0a0a0a;
      color: #e5e5e5;
      font-family: 'Inter', system-ui, sans-serif;
    }
    .glow-effect {
      box-shadow: 0 0 25px rgba(239, 68, 68, 0.15);
    }
  </style>
</head>
<body class="min-h-screen flex flex-col justify-between">

  <!-- Navigation Bar -->
  <nav class="border-b border-neutral-800 bg-neutral-950/80 backdrop-blur sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">
      <h1 class="text-xl font-black tracking-wider text-red-600 uppercase">STUDIO HUB</h1>
      <div class="space-x-6 text-sm font-medium">
        <a href="#books" class="hover:text-red-500 transition">Books</a>
        <a href="#videos" class="hover:text-red-500 transition">Anime Clips</a>
        <a href="#lore" class="hover:text-red-500 transition">Lore Bible</a>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <header class="max-w-5xl mx-auto px-6 py-20 text-center">
    <span class="text-xs uppercase tracking-widest font-semibold text-red-500 bg-red-950/50 px-3 py-1 rounded-full border border-red-800">Official Creative Archive</span>
    <h2 class="text-5xl md:text-7xl font-black tracking-tight mt-6 uppercase">Original Stories & Anime Teasers</h2>
    <p class="text-neutral-400 mt-4 max-w-2xl mx-auto text-lg">Step into the universe. Dark atmospheric narratives, heavy visual lore, and exclusive action clips.</p>
    <div class="mt-8 flex justify-center gap-4">
      <a href="#books" class="bg-red-600 hover:bg-red-700 text-white font-bold px-6 py-3 rounded-lg transition glow-effect">Read Stories</a>
      <a href="#videos" class="bg-neutral-800 hover:bg-neutral-700 text-white font-bold px-6 py-3 rounded-lg transition">Watch Clips</a>
    </div>
  </header>

  <!-- Main Content -->
  <main class="max-w-6xl mx-auto px-6 space-y-24 mb-20">

    <!-- Books Vault -->
    <section id="books">
      <h3 class="text-2xl font-extrabold uppercase border-l-4 border-red-600 pl-4 mb-8">The Book Vault</h3>
      <div class="grid md:grid-cols-2 gap-8">
        
        <!-- Book Card 1 -->
        <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-6 hover:border-red-900 transition">
          <div class="h-48 bg-neutral-800 rounded-lg flex items-center justify-center mb-4 text-neutral-500 font-bold uppercase tracking-wider">
            Cover Art Preview
          </div>
          <h4 class="text-xl font-bold">Go Ape</h4>
          <p class="text-neutral-400 text-sm mt-2">High-octane action and raw energy. Follow the journey through intensive battles and heavy grit.</p>
          <div class="mt-4 flex justify-between items-center">
            <span class="text-xs text-red-400 font-semibold uppercase">Active Series</span>
            <button class="bg-neutral-800 hover:bg-neutral-700 text-xs px-4 py-2 rounded-md font-semibold">Explore Lore</button>
          </div>
        </div>

        <!-- Book Card 2 -->
        <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-6 hover:border-red-900 transition">
          <div class="h-48 bg-neutral-800 rounded-lg flex items-center justify-center mb-4 text-neutral-500 font-bold uppercase tracking-wider">
            Cover Art Preview
          </div>
          <h4 class="text-xl font-bold">Dark Angel</h4>
          <p class="text-neutral-400 text-sm mt-2">Atmospheric suspense and deep character lore. A dark, methodical story built with patience and detail.</p>
          <div class="mt-4 flex justify-between items-center">
            <span class="text-xs text-red-400 font-semibold uppercase">Active Series</span>
            <button class="bg-neutral-800 hover:bg-neutral-700 text-xs px-4 py-2 rounded-md font-semibold">Explore Lore</button>
          </div>
        </div>

      </div>
    </section>

    <!-- Anime Video Clips Section -->
    <section id="videos">
      <h3 class="text-2xl font-extrabold uppercase border-l-4 border-red-600 pl-4 mb-8">Anime & Video Clips</h3>
      <div class="grid md:grid-cols-2 gap-8">
        
        <!-- Video Card 1 -->
        <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-4">
          <div class="aspect-video bg-neutral-950 rounded-lg flex items-center justify-center text-neutral-600 font-medium">
            [ Video / Teaser Embed ]
          </div>
          <h4 class="font-bold mt-4">Official Concept Trailer</h4>
          <p class="text-xs text-neutral-400 mt-1">High-impact animation clip showcasing key character style.</p>
        </div>

        <!-- Video Card 2 -->
        <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-4">
          <div class="aspect-video bg-neutral-950 rounded-lg flex items-center justify-center text-neutral-600 font-medium">
            [ Video / Teaser Embed ]
          </div>
          <h4 class="font-bold mt-4">Action Teaser Reel</h4>
          <p class="text-xs text-neutral-400 mt-1">Key moments and animation highlights.</p>
        </div>

      </div>
    </section>

  </main>

  <!-- Footer -->
  <footer class="border-t border-neutral-900 py-8 text-center text-xs text-neutral-500">
    <p>&copy; 2026 Studio Hub. All Rights Reserved.</p>
  </footer>

</body>
</html>
